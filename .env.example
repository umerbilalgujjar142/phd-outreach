# ─── App ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Postgres ───────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=
PG_DATABASE=phd_outreach

# ─── Redis / BullMQ ─────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── Gmail API (Section 10) ─────────────────────────────────
# From Google Cloud Console → OAuth client ID (Desktop app)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:5000/oauth2/callback
# Generated on first run after browser consent; reused thereafter
GMAIL_REFRESH_TOKEN=
# The address outreach is sent from (Umer's Gmail)
GMAIL_SENDER=

# ─── Claude Code CLI (Section 11) ───────────────────────────
# Path to the claude binary (shelled out via child_process for Step 4).
CLAUDE_BIN=claude

# ─── Sending limits (Section 8, Step 6) ─────────────────────
DAILY_SEND_MIN=5
DAILY_SEND_MAX=8
FOLLOWUP_DAYS=14

# ─── Documents (Section 13) ─────────────────────────────────
DOCS_DIR=./pdf
